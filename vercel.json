{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "framework": null,
  "headers": [
    {
      "source": "/assets/live-classroom-document-converter.html",
      "headers": [
        {
          "key": "Document-Isolation-Policy",
          "value": "isolate-and-require-corp"
        }
      ]
    },
    {
      "source": "/word-to-pdf.html",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        }
      ]
    },
    {
      "source": "/assets/word-engine/(.*)",
      "headers": [
        {
          "key": "Document-Isolation-Policy",
          "value": "isolate-and-require-corp"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/word-engine/soffice.wasm.br",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        },
        {
          "key": "Content-Encoding",
          "value": "br"
        }
      ]
    },
    {
      "source": "/assets/word-engine/soffice.data.br",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Encoding",
          "value": "br"
        }
      ]
    }
  ],
  "functions": {
    "api/live-classroom.js": {
      "maxDuration": 30
    },
    "api/signup-studio.js": {
      "maxDuration": 30
    },
    "api/challenge.js": {
      "includeFiles": "dist/**",
      "maxDuration": 30
    }
  }
}
